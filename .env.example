# Optional. Bakes the backend address into the build so nobody has to type it on
# first run. A value entered in the app always overrides this.
#
# Just the host — the client appends api/auth/login, api/scans and so on:
#   VITE_API_BASE=https://your-backend.example.com
#
# Use the same backend MyStokio signs in to. Accounts are shared.
VITE_API_BASE=
